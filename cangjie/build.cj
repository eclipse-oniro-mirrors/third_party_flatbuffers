// cjpm build script for the Cangjie flatbuffers runtime.
//
// The test cases under test/ are standalone programs that rely on code generated by
// flatc, so they are materialised into src/test_<suite>/ only while `cjpm test` runs.
// Every fixture is named *_test.cj, which keeps it out of `cjpm build` and out of the
// installed runtime. flatc is resolved from the compiler SDK, exactly like the rest of
// the tree does ($CANGJIE_HOME/third_party/flatbuffers/bin/flatc); $FLATC overrides it.

import std.env.*
import std.fs.*
import std.process.*

// (package suffix, schema, case source, flatc output stem, C++ writer, buffer file)
let TEST_SUITES: Array<(String, String, String, String, String, String)> = [
    ("test_all", "test/all/monster.fbs", "test/all/main.cj", "monster_generated", "", ""),
    ("test_union", "test/union/union.fbs", "test/union/main.cj", "union_generated",
        "test/union/main.cpp", "union.buf"),
    ("test_struct_and_string", "test/struct_and_string/struct_and_string.fbs",
        "test/struct_and_string/main.cj", "struct_and_string_generated",
        "test/struct_and_string/main.cpp", "struct_and_string.buf")
]

let INTEROP_DIR = "build-script-cache/interop"
let HEADERS_DIR = "../include"

main(): Int64 {
    let args = getCommandLine()
    if (args.size < 2) {
        return 0
    }
    match (args[1]) {
        case "pre-test" => generateTestFixtures()
        case "pre-clean" => cleanTestFixtures()
        case _ => 0
    }
}

@When[os == "Windows"]
func flatcFileName(): String {
    return "flatc.exe"
}

@When[os != "Windows"]
func flatcFileName(): String {
    return "flatc"
}

func resolveFlatc(): String {
    if (let Some(flatc) <- getVariable("FLATC")) {
        if (!flatc.isEmpty() && exists(Path(flatc))) {
            return flatc
        }
    }
    if (let Some(cangjieHome) <- getVariable("CANGJIE_HOME")) {
        let flatc = cangjieHome + "/third_party/flatbuffers/bin/" + flatcFileName()
        if (exists(Path(flatc))) {
            return flatc
        }
    }
    return ""
}

func ensureDir(path: String): Unit {
    if (!exists(Path(path))) {
        Directory.create(Path(path), recursive: true)
    }
}

func generateTestFixtures(): Int64 {
    let flatc = resolveFlatc()
    if (flatc.isEmpty()) {
        println("error: cannot locate flatc. Set $FLATC or install cangjie_compiler so that " +
            "$CANGJIE_HOME/third_party/flatbuffers/bin/flatc exists.")
        return 1
    }
    for ((suite, schema, caseFile, stem, writer, buffer) in TEST_SUITES) {
        let outDir = "src/" + suite
        if (exists(Path(outDir))) {
            remove(Path(outDir), recursive: true)
        }
        ensureDir(outDir)

        // Generate the Cangjie binding. It is renamed to *_test.cj so that cjpm only
        // compiles it for tests, never for the library.
        let rc = execute(flatc, "--no-warnings", "--cangjie", "--cangjie-package",
            "flatbuffers." + suite, "-o", outDir, schema)
        if (rc != 0) {
            println("error: flatc failed to generate ${schema} (exit code ${rc})")
            return rc
        }
        rename(outDir + "/" + stem + ".cj", to: outDir + "/" + stem + "_test.cj", overwrite: true)

        // Port the standalone case file into the generated package.
        let header = "package flatbuffers." + suite + "\n\nimport flatbuffers.*\n\n"
        File.writeTo(outDir + "/main_test.cj", header.toArray())
        File.appendTo(outDir + "/main_test.cj", File.readFrom(caseFile))

        // Cross-language suites read a buffer produced by a C++ writer.
        if (!writer.isEmpty() && !buffer.isEmpty()) {
            let interop = generateInteropBuffer(flatc, suite, schema, writer)
            if (interop != 0) {
                return interop
            }
        }
    }
    return 0
}

func generateInteropBuffer(flatc: String, suite: String, schema: String, writer: String): Int64 {
    ensureDir(INTEROP_DIR)
    var rc = execute(flatc, "--no-warnings", "--cpp", "-o", INTEROP_DIR, schema)
    if (rc != 0) {
        println("error: flatc failed to generate C++ headers for ${schema} (exit code ${rc})")
        return rc
    }
    let binary = INTEROP_DIR + "/write_" + suite
    // -static: avoid runtime dependency on mingw DLLs (libstdc++/libgcc/libwinpthread),
    // which are easily shadowed by other toolchains on PATH.
    rc = execute("g++", writer, "-I" + INTEROP_DIR, "-I" + HEADERS_DIR, "-o", binary, "-static")
    if (rc != 0) {
        println("error: g++ failed to build ${writer} (exit code ${rc})")
        return rc
    }
    // Run from the project root so the buffer lands where the test expects it.
    rc = execute("./" + binary)
    if (rc != 0) {
        println("error: ${binary} failed to write the interop buffer (exit code ${rc})")
        return rc
    }
    return 0
}

func cleanTestFixtures(): Int64 {
    for ((suite, _, _, _, _, buffer) in TEST_SUITES) {
        let outDir = "src/" + suite
        if (exists(Path(outDir))) {
            remove(Path(outDir), recursive: true)
        }
        if (!buffer.isEmpty() && exists(Path(buffer))) {
            remove(Path(buffer))
        }
    }
    if (exists(Path(INTEROP_DIR))) {
        remove(Path(INTEROP_DIR), recursive: true)
    }
    return 0
}